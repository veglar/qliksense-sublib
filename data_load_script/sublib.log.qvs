///$tab sublib.log
 /**
 Log functions that save info about:
 - Start 
 - End time
 - Header
 - Description
 */      
    SUB log (_log_header, _log_description)
	/*
	    Single line logging
	*/
		if isnull(TableNumber('log_event')) OR isnull(log_depth) then
	        LET log_depth= 1;
	    else 
	      	log_depth=log_depth;
	    endif
	    
		log_event:
      	LOAD 
        	rowno() as log_id,
        	$(log_depth) as [log_depth],
            '$(_log_header)' as [log_header],
          	'$(_log_description)' as [log_description],
          	Now() as [log_start_time],
          	Now() as [log_end_time],
          	0 as log_duration
      	AutoGenerate 1;
	
    ENDSUB
    
    
    
    SUB log_start (_log_header, _log_description)
    /**
    Starts a new logging procedure
    @param1 [Optional] Header for the log row to be saved
    @param2 [Optional] Description for the log row to be saved
    */
    	
    /*Creates or adds +1 to log_depth for each iteration*/
    if isnull(TableNumber('log_event')) OR isnull(log_depth) then
        LET log_depth= 1;
    else 
      	log_depth=log_depth+1;
    endif
        log_event:
      	LOAD 
        	rowno() as log_id,
        	//AutoNumberHash256(now(),'$(_log_header)') as [log_id],
            $(log_depth) as [log_depth],
            '$(_log_header)' as [log_header],
          	'$(_log_description)' as [log_description],
          	Now() as [log_start_time],
          	Timestamp(null()) as [log_end_time],
          	interval(null()) as log_duration
      	AutoGenerate 1;
        SET _log_header=;
        SET _log_description=;
  	ENDSUB //log_start

  	SUB log_end
	    /**
	    Closes the last opened log row. This call adds a [log_end_time] to the row.
	    */
	     tmp_log_event:      
	    	NoConcatenate
	   	LOAD
	     	[log_id],
	       	[log_depth], 
	       	[log_header], 
	       	[log_description],
	       	[log_start_time], 
	       	timestamp(now()) as [log_end_time],
	       	timestamp(now()) - 	[log_start_time] as log_duration
	   	Resident log_event 
	   	Where 
	       	[log_depth] = $(log_depth) 
	       	AND isnull( [log_end_time]);
	       	
	   	Concatenate LOAD 
	       	[log_id],
	       	[log_depth],
	       	[log_header],
	       	[log_description],
	       	[log_start_time],
	       	timestamp([log_end_time]) as [log_end_time],
	       	log_duration
	   Resident 
	       log_event
	   Where 
	       NOT ( 
	           [log_depth] = $(log_depth) 
	           AND isnull( [log_end_time])
	           )
	   ;
	  DROP table log_event;
	  RENAME Table tmp_log_event to log_event;
	  
	  /*
	  	Resets or reduces log_depth by -1 for each iteration.
	    Resetting is done to avoid the variable remaining in the application after execution.
	    NOTE: If not all starts are closed with a stop, the variable will remain with a value.
	  */
	  IF  log_depth = 1 then
	  	SET log_depth =;
	  ELSE 
	  	LET log_depth= log_depth-1; //alt(log_depth-1, 0);
	  ENDIF
	  SET _log_header=;
  ENDSUB //log_end